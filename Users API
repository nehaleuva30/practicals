Model:

struct User: Codable {
    let id: Int
    let name: String
    let email: String
}

Call:

func getUsers() {
    APIService.shared.fetchData(url: "https://jsonplaceholder.typicode.com/users") { (result: Result<[User], Error>) in
        switch result {
        case .success(let users):
            print(users)
        case .failure(let error):
            print(error)
        }
    }
}
